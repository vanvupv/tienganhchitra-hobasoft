          "isInner": false,
          "settings": {
            "slides": [
              {
                "_id": "rev_slide_1",
                "image": {
                  "url": "https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=200&auto=format&fit=crop"
                },
                "name": "Chị Lê Thu Hà",
                "title": "Kinh doanh tự do",
                "rating": 5,
                "content": "“Tôi lựa chọn Tiếng Anh Chị Trà vì chương trình học bài bản và môi trường tương tác rất hiện đại. Con tôi từ rụt rè nay rất hào hứng đi học và tự tin sử dụng tiếng Anh mỗi ngày.”"
              },
              {
                "_id": "rev_slide_2",
                "image": {
                  "url": "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=200&auto=format&fit=crop"
                },
                "name": "Anh Trần Minh Hoàng",
                "title": "Kỹ sư",
                "rating": 5,
                "content": "“Trung tâm có lộ trình học khoa học, giáo viên trách nhiệm và báo cáo kết quả học tập minh bạch. Con tôi học tập nghiêm túc hơn và có sự tiến bộ rõ rệt qua từng tháng.”"
              },
              {
                "_id": "rev_slide_3",
                "image": {
                  "url": "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=200&auto=format&fit=crop"
                },
                "name": "Anh Phạm Quang Huy",
                "title": "Giáo viên",
                "rating": 5,
                "content": "“Là người làm trong ngành giáo dục, tôi đánh giá cao phương pháp giảng dạy tại đây. Nội dung học phù hợp, dễ tiếp thu và theo sát năng lực thực tế của từng học viên.”"
              }
            ],
            "slides_per_view": "3",
            "slides_per_view_tablet": "2",
            "slides_per_view_mobile": "1",
            "slides_to_scroll": "1",
