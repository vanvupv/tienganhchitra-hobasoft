        {
          "id": "e00f6e13",
          "elType": "widget",
          "widgetType": "text-editor",
          "isInner": false,
          "settings": {
            "editor": "<p style='text-align: center;'>Bên cạnh đội ngũ giảng viên tâm huyết và giáo trình chuẩn hóa, Tiếng Anh Chị Trà luôn chú trọng đầu tư hệ thống cơ sở vật chất khang trang, hiện đại bậc nhất. Từng góc học tập, từng chiếc bàn chiếc ghế đều được thiết kế tỉ mỉ nhằm mang lại cho học sinh môi trường học tập an toàn, thân thiện, kích thích tối đa sự sáng tạo và niềm hứng khởi trong mỗi buổi học.</p>",
            "align": "center",
            "text_color": "#4B5563",
            "typography_typography": "custom",
            "typography_font_family": "Plus Jakarta Sans",
            "typography_font_size": {
              "unit": "px",
              "size": 16
            },
            "typography_line_height": {
              "unit": "em",
              "size": 1.7
            }
